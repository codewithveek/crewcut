{
  // Crewcut on Cloudflare: a Worker in front of one container running the app.
  // Secrets (keys, DATABASE_URL, R2_*): `npx wrangler secret put NAME`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crewcut",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // getcrewcut.app serves the app; the workers.dev address keeps working too.
  "routes": [{ "pattern": "getcrewcut.app", "custom_domain": true }],
  "workers_dev": true,
  // Wakes the app once a day so its scheduled jobs run even with no visitors (see worker.ts).
  "triggers": { "crons": ["17 3 * * *"] },
  "containers": [
    {
      "class_name": "CrewcutApp",
      "image": "./Dockerfile",
      "image_build_context": "../..",
      // 2 vCPU, 8 GiB: enough for Chromium renders next to the web app.
      "instance_type": "standard-3",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "APP", "class_name": "CrewcutApp" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CrewcutApp"] }],
  "vars": {
    "CREWCUT_STORAGE": "remote",
    "APP_URL": "https://getcrewcut.app",
    "BETTER_AUTH_URL": "https://getcrewcut.app",
    "YOUTUBE_REDIRECT_URI": "https://getcrewcut.app/api/connections/youtube/callback",
    // Email (Resend; RESEND_API_KEY is a secret). mail.getcrewcut.app is the
    // domain verified in Resend, sending only: nobody reads replies there.
    "EMAIL_FROM": "Crewcut <noreply@mail.getcrewcut.app>",
    "APP_NAME": "Crewcut",
    // A PNG: email clients don't show SVG logos.
    "APP_LOGO_URL": "https://getcrewcut.app/email-logo.png"
  }
}
