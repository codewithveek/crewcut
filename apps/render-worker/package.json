{
  "name": "@crewcut/render-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "render": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit -p .",
    "template-stills": "tsx --env-file-if-exists=../studio/.env src/template-stills.ts",
    "transition-stills": "tsx --env-file-if-exists=../studio/.env src/transition-stills.ts",
    "landing-videos": "tsx --env-file-if-exists=../studio/.env src/landing-videos.ts",
    "og-images": "tsx --env-file-if-exists=../studio/.env src/og-images.ts",
    "composition-stills": "tsx --env-file-if-exists=../studio/.env src/composition-stills.ts",
    "films": "tsx --env-file-if-exists=../studio/.env src/films/main.ts"
  },
  "dependencies": {
    "@crewcut/composition": "workspace:*",
    "@crewcut/renderer": "workspace:*",
    "@remotion/bundler": "4.0.536",
    "@remotion/renderer": "4.0.536",
    "remotion": "4.0.536",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.4.3",
    "@crewcut/pipeline": "workspace:*",
    "@crewcut/stock": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.14"
  }
}
