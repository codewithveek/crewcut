# ── Local development ───────────────────────────────────────────────────────
# Skip sign-in locally (never in production).
AUTH_DISABLED=true
# Default: in-process PGlite at apps/studio/data/pglite. For a shared database
# (needed by `pnpm worker` queue mode) use Postgres:
# DATABASE_URL=postgres://proofcut:proofcut@localhost:5432/proofcut

# ── Production secrets ──────────────────────────────────────────────────────
# BETTER_AUTH_SECRET=        # stable session secret (Agent-Native)
# PROOFCUT_MEDIA_SECRET=     # signs short-lived media URLs
# OAUTH_STATE_SECRET=        # signs OAuth state (falls back to BETTER_AUTH_SECRET)
# APP_URL=https://proofcut.example.com

# ── Models ──────────────────────────────────────────────────────────────────
# Connect a model in agent settings, or set a provider key here for local use.
# ANTHROPIC_API_KEY=

# ── Voice (optional; per-person keys can be saved in Settings → Connections) ─
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# ── YouTube (Google Cloud OAuth client with YouTube Data + Analytics APIs) ───
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REDIRECT_URI=http://localhost:8080/api/connections/youtube/callback

# ── Rendering ───────────────────────────────────────────────────────────────
# spawn (default with PGlite) or queue (Postgres + `pnpm worker`)
# PROOFCUT_RENDER_MODE=spawn
# PROOFCUT_STORAGE_DIR=./storage
# Use a local Chrome/Edge if Remotion can't download Chrome Headless Shell.
# PROOFCUT_BROWSER_EXECUTABLE=C:/Program Files/Google/Chrome/Application/chrome.exe
