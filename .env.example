# ── Local development ───────────────────────────────────────────────────────
# Skip sign-in locally (never in production).
AUTH_DISABLED=true
# Default: in-process PGlite at apps/studio/data/pglite. For a shared database
# (needed by `pnpm worker` queue mode) use Postgres:
# DATABASE_URL=postgres://crewcut:crewcut@localhost:5432/crewcut
# ── Production secrets ──────────────────────────────────────────────────────
# BETTER_AUTH_SECRET=        # stable session secret (Agent-Native)
# CREWCUT_MEDIA_SECRET=     # signs short-lived media URLs
# OAUTH_STATE_SECRET=        # signs OAuth state (falls back to BETTER_AUTH_SECRET)
# APP_URL=https://getcrewcut.example.com
# Catalog admins (the /admin area: packs, templates, music, sounds, Pro plans),
# comma-separated. In production nobody is an admin until this is set; on a
# developer's machine with it unset, the local user is.
# CREWCUT_ADMIN_EMAILS=you@example.com

# ── Crewcut AI (the crew on our accounts, paid with credits) ────────────────
# Every model call goes through the "crewcut" engine: a person's own provider
# key when they saved one (no credits), else Crewcut AI through Cloudflare AI
# Gateway. Don't set ANTHROPIC_API_KEY / OPENAI_API_KEY here in production:
# the framework would use them directly, skipping the gateway and credits.
# CREWCUT_AI_GATEWAY_ACCOUNT_ID=      # falls back to CLOUDFLARE_ACCOUNT_ID
# CREWCUT_AI_GATEWAY_ID=crewcut
# CREWCUT_AI_GATEWAY_TOKEN=           # Cloudflare API token: AI Gateway Run + Workers AI (falls back to CLOUDFLARE_API_TOKEN / CLOUDFLARE_API_KEY)
# CREWCUT_AI_GATEWAY_KEY_ALIAS=       # stored-key alias in the gateway (default alias when unset)
# CREWCUT_AI_GATEWAY=off              # switch Crewcut AI off
# Providers: Crewcut's own key per provider (sent through the gateway). Without
# one, list the provider in CREWCUT_AI_PROVIDERS and store its key in the
# gateway (or use Cloudflare Unified Billing). Workers AI needs no key.
# CREWCUT_AI_ANTHROPIC_KEY=
# CREWCUT_AI_OPENAI_KEY=
# CREWCUT_AI_GOOGLE_KEY=
# CREWCUT_AI_PROVIDERS=anthropic,workers-ai
# CREWCUT_AI_DEFAULT_MODEL=claude-sonnet-5-5
# CREWCUT_AI_MODELS=[{"id":"...","provider":"workers-ai","label":"...","tier":"economy","inputPerMTok":0.3,"outputPerMTok":0.9,"priceSource":"..."}]
# Credits: 1 credit = CREWCUT_CREDIT_USD at top-up prices; a call costs its
# measured provider cost × CREWCUT_CREDIT_MARKUP.
# CREWCUT_CREDIT_USD=0.05
# CREWCUT_CREDIT_MARKUP=3
# Local development only: a provider key here is used when the gateway isn't set up.
# ANTHROPIC_API_KEY=

# ── Voice (per-person keys can be saved under Connect) ──────────────────────
# Crewcut's ElevenLabs key voices videos for people without their own key
# (paid with credits). CREWCUT_VOICE_ELEVENLABS_KEY falls back to this one.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# CREWCUT_VOICE_ELEVENLABS_KEY=
# CREWCUT_VOICE_USD_PER_1K_CHARS=0.10   # our cost; on a subscription: plan price ÷ included characters × 1000
# CREWCUT_VOICE=off                     # never voice on Crewcut's key

# ── Payments (Bachs) ────────────────────────────────────────────────────────
# pnpm --filter @crewcut/studio billing:setup creates the products and prints
# the BACHS_PRODUCT_* lines. Register https://<app>/api/billing/webhook in the
# Bachs developer portal.
# BACHS_SECRET_KEY=sk_sandbox_...
# BACHS_WEBHOOK_SECRET=               # comma-separate two while rotating
# BACHS_PRODUCT_CREATOR_MONTH=
# BACHS_PRODUCT_CREATOR_YEAR=
# BACHS_PRODUCT_STUDIO_MONTH=
# BACHS_PRODUCT_STUDIO_YEAR=
# BACHS_PRODUCT_TOPUP_300=
# BACHS_PRODUCT_TOPUP_1000=
# BACHS_NGN_PER_USD=1500              # optional, setup only: naira price on top-ups
# BACHS_RETURN_ORIGIN=https://<tunnel>.trycloudflare.com   # local dev only: Bachs refuses localhost return links

# ── YouTube (Google Cloud OAuth client with YouTube Data + Analytics APIs) ───
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REDIRECT_URI=http://localhost:8080/api/connections/youtube/callback
# API key (same Google Cloud project, YouTube Data API v3) for the trend agent's
# public outlier search (find-outliers). Not a person's account. ~120 quota units a search.
# YOUTUBE_API_KEY=
# CREWCUT_OUTLIER_SEARCHES_PER_DAY=15

# ── Rendering ───────────────────────────────────────────────────────────────
# spawn (default with PGlite) or queue (Postgres + `pnpm worker`)
# CREWCUT_RENDER_MODE=spawn
# CREWCUT_STORAGE_DIR=./storage
# Use a local Chrome/Edge if Remotion can't download Chrome Headless Shell.
# CREWCUT_BROWSER_EXECUTABLE=C:/Program Files/Google/Chrome/Application/chrome.exe

# ── File storage ────────────────────────────────────────────────────────────
# auto (default): uploads, voice-overs and renders go to the bucket below when
# it's configured, else stay on local disk. local: always disk. remote: any
# configured provider, Builder's file storage included; refuses to fall back.
# CREWCUT_STORAGE=auto
# Cloudflare R2 (or S3_* for any S3-compatible bucket). People get presigned
# links to the endpoint that expire after hours, so the bucket can be PRIVATE
# (no r2.dev, no public custom domain). The endpoint must be HTTPS. Allow the
# app's origins in the bucket's CORS rules (GET, HEAD, header Range).
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=crewcut-media
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Still required by the framework: files are recorded under this address,
# and only files under it (or a former one below) are signed with the keys above.
# R2_PUBLIC_BASE_URL=https://media.getcrewcut.example.com
# Former public addresses of the same bucket, comma-separated (e.g. an r2.dev
# address used before a custom domain), so older files get signed links too.
# CREWCUT_MEDIA_PUBLIC_BASES=https://pub-<id>.r2.dev
